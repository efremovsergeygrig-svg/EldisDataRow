@page "/meteringpoints"
@using EldisDataLoader.Web.Services
@using Microsoft.Extensions.Caching.Memory    
@inject MeteringPointsService MeteringPointsService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IMemoryCache Cache


<PageTitle>Точки учёта - Eldis</PageTitle>

<style>
    .table-scroll-container {
        height: calc(100vh - 280px);
        overflow-y: auto;
        overflow-x: auto;
    }

    .sticky-thead th {
        position: sticky;
        top: 0;
        background-color: #212529 !important;
        color: white !important;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        white-space: nowrap;
    }

    .clickable-row {
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .clickable-row:hover {
            background-color: rgba(13, 110, 253, 0.1) !important;
        }

    .selected-row {
        background-color: rgba(13, 110, 253, 0.2) !important;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-geo-alt text-primary"></i> Точки учёта
    </h2>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary fs-6">
            Всего: @pointsList.Count
        </span>
        <button class="btn btn-sm btn-outline-primary" @onclick="ReloadDataAsync" disabled="@isLoading" title="Принудительно обновить данные из базы">
            <i class="bi bi-arrow-clockwise"></i> Обновить
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(loadStatus))
{
    <div class="alert alert-info py-2 mb-3">
        <small><i class="bi bi-info-circle"></i> @loadStatus</small>
    </div>
}

@if (isLoading)
{
    <div class="card shadow-sm p-5 text-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <div class="mt-3 text-muted fw-semibold">Загрузка справочника точек учёта...</div>
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text" class="form-control" placeholder="Поиск по серийному номеру, названию прибора, адресу..." @bind="searchTerm" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i> Очистить
                    </button>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-light border mb-3 py-2">
            <i class="bi bi-funnel"></i> Найдено: <strong>@filteredPoints.Count()</strong> из <strong>@pointsList.Count</strong> по запросу "<em>@searchTerm</em>"
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!SortedPoints.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-emoji-frown fs-1"></i>
                    <p class="mt-2 mb-0">По вашему запросу ничего не найдено</p>
                </div>
            }
            else
            {
                <div class="table-responsive table-scroll-container">
                     <table class="table table-hover table-striped table-sm mb-0 compact-table">
                        <thead class="table-dark sticky-thead">
                            <tr>
                                <th @onclick="@(() => SortBy("RowNumber"))" style="cursor: pointer; width: 60px; text-align: center;">🔢 № @GetSortIcon("RowNumber")</th>
                                <th @onclick="@(() => SortBy("SerialNumber"))" style="cursor: pointer;">🆔 № ПУ @GetSortIcon("SerialNumber")</th>
                                <th @onclick="@(() => SortBy("DeviceName"))" style="cursor: pointer;">⚙️ Прибор учёта @GetSortIcon("DeviceName")</th>
                                <th @onclick="@(() => SortBy("Address"))" style="cursor: pointer;">📍 Адрес @GetSortIcon("Address")</th>
                                <th @onclick="@(() => SortBy("ResourceName"))" style="cursor: pointer;">⚡ Ресурс @GetSortIcon("ResourceName")</th>
                                <th @onclick="@(() => SortBy("MeasurePointName"))" style="cursor: pointer;">📌 Название точки @GetSortIcon("MeasurePointName")</th>
                                <th @onclick="@(() => SortBy("CreatedOn"))" style="cursor: pointer; width: 120px;">📅 Дата создания @GetSortIcon("CreatedOn")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isSorting)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="d-flex flex-column align-items-center">
                                            <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                                            <div class="mt-2 text-muted small">Сортировка данных...</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vm in SortedPoints)
                                {
                                    <tr class="clickable-row @(selectedPointId == vm.Point.Id ? "selected-row" : "")"
                                        @onclick="@(() => GoToDebug(vm.Point.Id))"
                                        title="Выделите строку, затем перейдите в Отладку">
                                        <td class="text-center text-muted fw-bold">@vm.RowNumber</td>
                                        <td class="fw-semibold">@HighlightText(vm.Point.SerialNumber ?? "—")</td>
                                        <td>@HighlightText(vm.Point.DeviceName ?? "—")</td>
                                        <td>@HighlightText(vm.Point.Address ?? "—")</td>
                                        <td>@HighlightText(vm.Point.ResourceName ?? "—")</td>
                                        <td>@HighlightText(vm.Point.MeasurePointName ?? "—")</td>
                                        <td>
                                            <small class="text-muted" style="white-space: nowrap;">
                                                @vm.Point.CreatedOn?.ToString("dd.MM.yyyy")
                                            </small>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private const string CacheKey = "MeteringPoints_CachedData";

    private class MeteringPointViewModel
    {
        public int RowNumber { get; set; }
        public MeteringPointViewDto Point { get; set; }
    }

    private List<MeteringPointViewModel> pointsList = new();
    private bool isLoading = true;
    private bool isSorting = false;
    private string searchTerm = "";
    private string loadStatus = "Проверка кэша...";

    private string sortColumn = "RowNumber";
    private bool sortAscending = true;

    private IEnumerable<MeteringPointViewModel> SortedPoints => ApplySorting(filteredPoints);
    private Guid selectedPointId;

    protected override async Task OnInitializedAsync()
    {
        // 1. Пытаемся получить данные из надежного кэша памяти
        if (Cache.TryGetValue(CacheKey, out List<MeteringPointViewModel> cachedData) && cachedData.Any())
        {
            pointsList = cachedData;
            isLoading = false;
            loadStatus = "✅ Загружено мгновенно из кэша памяти";
        }
        else
        {
            // 2. Если в кэше пусто — грузим из базы
            loadStatus = "⏳ Загрузка из базы данных...";
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var rawPoints = await MeteringPointsService.GetAllMeteringPointsAsync();
            pointsList = rawPoints.Select((p, index) => new MeteringPointViewModel
            {
                RowNumber = index + 1,
                Point = p
            }).ToList();

            // Сохраняем в кэш на 2 часа (или пока не нажмут "Обновить")
            Cache.Set(CacheKey, pointsList, TimeSpan.FromHours(2));
            loadStatus = "✅ Загружено из базы и сохранено в кэш";
        }
        catch (Exception ex)
        {
            loadStatus = $"❌ Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Метод для кнопки "Обновить": чистим кэш и грузим заново
    private async Task ReloadDataAsync()
    {
        Cache.Remove(CacheKey);
        loadStatus = " Обновление данных из базы...";
        await LoadDataAsync();
    }

    private async Task SortByAsync(string columnName)
    {
        if (sortColumn == columnName)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = columnName;
            sortAscending = true;
        }

        isSorting = true;
        StateHasChanged();
        await Task.Delay(50);
        await Task.Run(() => { _ = SortedPoints.ToList(); });
        isSorting = false;
        StateHasChanged();
    }

    private void SortBy(string columnName) { _ = SortByAsync(columnName); }

    private string GetSortIcon(string columnName)
    {
        if (sortColumn != columnName) return "";
        return sortAscending ? " ▲" : " ▼";
    }

    private IEnumerable<MeteringPointViewModel> ApplySorting(IEnumerable<MeteringPointViewModel> data)
    {
        if (string.IsNullOrEmpty(sortColumn)) return data;

        if (sortAscending)
        {
            return sortColumn switch
            {
                "RowNumber" => data.OrderBy(x => x.RowNumber),
                "SerialNumber" => data.OrderBy(x => x.Point.SerialNumber),
                "DeviceName" => data.OrderBy(x => x.Point.DeviceName),
                "Address" => data.OrderBy(x => x.Point.Address),
                "ResourceName" => data.OrderBy(x => x.Point.ResourceName),
                "MeasurePointName" => data.OrderBy(x => x.Point.MeasurePointName),
                "CreatedOn" => data.OrderBy(x => x.Point.CreatedOn),
                _ => data
            };
        }
        else
        {
            return sortColumn switch
            {
                "RowNumber" => data.OrderByDescending(x => x.RowNumber),
                "SerialNumber" => data.OrderByDescending(x => x.Point.SerialNumber),
                "DeviceName" => data.OrderByDescending(x => x.Point.DeviceName),
                "Address" => data.OrderByDescending(x => x.Point.Address),
                "ResourceName" => data.OrderByDescending(x => x.Point.ResourceName),
                "MeasurePointName" => data.OrderByDescending(x => x.Point.MeasurePointName),
                "CreatedOn" => data.OrderByDescending(x => x.Point.CreatedOn),
                _ => data
            };
        }
    }

    private IEnumerable<MeteringPointViewModel> filteredPoints => string.IsNullOrWhiteSpace(searchTerm)
        ? pointsList
        : pointsList.Where(vm =>
            (vm.Point.SerialNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Point.DeviceName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Point.Address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Point.ResourceName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Point.MeasurePointName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    private void ClearSearch() { searchTerm = ""; }

    private MarkupString HighlightText(string? text)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrWhiteSpace(searchTerm))
        {
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text ?? "—"));
        }

        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var encodedSearch = System.Net.WebUtility.HtmlEncode(searchTerm);

        var highlighted = System.Text.RegularExpressions.Regex.Replace(
                    encoded,
                    System.Text.RegularExpressions.Regex.Escape(encodedSearch),
                    $"<mark>{encodedSearch}</mark>",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase
                );

        return new MarkupString(highlighted);
    }

    private async Task GoToDebug(Guid pointId)
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "selectedPointId", pointId.ToString());
    }
}