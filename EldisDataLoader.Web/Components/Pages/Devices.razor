@page "/devices"
@using EldisDataLoader.Models
@inject EldisDataLoader.Web.Services.DevicesService DevicesService

<PageTitle>Приборы учёта - Eldis</PageTitle>

<style>
    /* Контейнер с фиксированной высотой и скроллом */
    .table-scroll-container {
        height: calc(100vh - 280px);
        overflow-y: auto;
        overflow-x: auto;
    }

    /* Делаем заголовок "липким" */
    .sticky-thead th {
        position: sticky;
        top: 0;
        background-color: #212529 !important;
        color: white !important;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        white-space: nowrap;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-cpu text-primary"></i> Приборы учёта
    </h2>
    <span class="badge bg-primary fs-6">
        Всего: @devicesList.Count
    </span>
</div>

@if (isLoading)
{
    <div class="card shadow-sm p-5 text-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <div class="mt-3 text-muted fw-semibold">Загрузка справочника приборов...</div>
    </div>
}
else
{
    <!-- Поле поиска -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text"
                       class="form-control"
                       placeholder="Поиск по названию, модели, адресу, объекту или модему..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i> Очистить
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Информация о результатах поиска -->
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-light border mb-3 py-2">
            <i class="bi bi-funnel"></i>
            Найдено: <strong>@filteredDevices.Count()</strong> из <strong>@devicesList.Count</strong>
            по запросу "<em>@searchTerm</em>"
        </div>
    }

    <!-- Таблица с результатами -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!SortedDevices.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-emoji-frown fs-1"></i>
                    <p class="mt-2 mb-0">По вашему запросу ничего не найдено</p>
                </div>
            }
            else
            {
                <div class="table-responsive table-scroll-container">
                    <table class="table table-hover table-striped table-sm mb-0 compact-table">
                        <thead class="table-dark sticky-thead">
                            <tr>
                                <th @onclick="@(() => SortBy("RowNumber"))" style="cursor: pointer; width: 60px; text-align: center;">🔢 № @GetSortIcon("RowNumber")</th>
                                <th @onclick="@(() => SortBy("DeviceName"))" style="cursor: pointer;">📛 Название @GetSortIcon("DeviceName")</th>
                                <th @onclick="@(() => SortBy("DeviceModel"))" style="cursor: pointer;">️ Модель @GetSortIcon("DeviceModel")</th>
                                <th @onclick="@(() => SortBy("AddressObject"))" style="cursor: pointer;">📍 Адрес @GetSortIcon("AddressObject")</th>
                                <th @onclick="@(() => SortBy("ObjectName"))" style="cursor: pointer;">🏢 Объект @GetSortIcon("ObjectName")</th>
                                <th @onclick="@(() => SortBy("ModemName"))" style="cursor: pointer;">📡 Модем @GetSortIcon("ModemName")</th>
                                <th @onclick="@(() => SortBy("DeviceStatus"))" style="cursor: pointer; width: 80px; text-align: center;">✅ Статус @GetSortIcon("DeviceStatus")</th>
                                <th @onclick="@(() => SortBy("CreatedOn"))" style="cursor: pointer; width: 120px;">📅 Дата создания @GetSortIcon("CreatedOn")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isSorting)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="d-flex flex-column align-items-center">
                                            <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                                            <div class="mt-2 text-muted small">Сортировка данных...</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vm in SortedDevices)
                                {
                                    <tr>
                                        <td class="text-center text-muted fw-bold">@vm.RowNumber</td>
                                        <td class="fw-semibold">@HighlightText(vm.Device.DeviceName ?? "—")</td>
                                        <td>@HighlightText(vm.Device.DeviceModel ?? "—")</td>
                                        <td style="white-space: nowrap;">@HighlightText(vm.Device.AddressObject ?? "—")</td>
                                        <td>@HighlightText(vm.Device.ObjectName ?? "—")</td>
                                        <td>@HighlightText(vm.Device.ModemName ?? "—")</td>
                                        <td class="text-center">
                                            @if (vm.Device.DeviceStatus.HasValue)
                                            {
                                                <span class="badge @(vm.Device.DeviceStatus == 1 ? "bg-success" : "bg-secondary")">
                                                    @vm.Device.DeviceStatus
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted" style="white-space: nowrap;">
                                                @vm.Device.CreatedOn?.ToString("dd.MM.yyyy")
                                            </small>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    // 🎯 КЛАССИЧЕСКИЙ ПАТТЕРН: ViewModel для добавления UI-поля без изменения исходного DTO
    private class DeviceViewModel
    {
        public int RowNumber { get; set; }
        public DeviceDto Device { get; set; }
    }

    private List<DeviceViewModel> devicesList = new();
    private bool isLoading = true;
    private bool isSorting = false;
    private string searchTerm = "";

    private string sortColumn = "RowNumber";
    private bool sortAscending = true;

    private IEnumerable<DeviceViewModel> SortedDevices => ApplySorting(filteredDevices);

    private async Task SortByAsync(string columnName)
    {
        if (sortColumn == columnName)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = columnName;
            sortAscending = true;
        }

        isSorting = true;
        StateHasChanged();
        await Task.Delay(50);
        await Task.Run(() => { _ = SortedDevices.ToList(); });
        isSorting = false;
        StateHasChanged();
    }

    private void SortBy(string columnName) { _ = SortByAsync(columnName); }

    private string GetSortIcon(string columnName)
    {
        if (sortColumn != columnName) return "";
        return sortAscending ? " ▲" : " ▼";
    }

    private IEnumerable<DeviceViewModel> ApplySorting(IEnumerable<DeviceViewModel> data)
    {
        if (string.IsNullOrEmpty(sortColumn)) return data;

        if (sortAscending)
        {
            return sortColumn switch
            {
                "RowNumber" => data.OrderBy(x => x.RowNumber),
                "DeviceName" => data.OrderBy(x => x.Device.DeviceName),
                "DeviceModel" => data.OrderBy(x => x.Device.DeviceModel),
                "AddressObject" => data.OrderBy(x => x.Device.AddressObject),
                "ObjectName" => data.OrderBy(x => x.Device.ObjectName),
                "ModemName" => data.OrderBy(x => x.Device.ModemName),
                "DeviceStatus" => data.OrderBy(x => x.Device.DeviceStatus),
                "CreatedOn" => data.OrderBy(x => x.Device.CreatedOn),
                _ => data
            };
        }
        else
        {
            return sortColumn switch
            {
                "RowNumber" => data.OrderByDescending(x => x.RowNumber),
                "DeviceName" => data.OrderByDescending(x => x.Device.DeviceName),
                "DeviceModel" => data.OrderByDescending(x => x.Device.DeviceModel),
                "AddressObject" => data.OrderByDescending(x => x.Device.AddressObject),
                "ObjectName" => data.OrderByDescending(x => x.Device.ObjectName),
                "ModemName" => data.OrderByDescending(x => x.Device.ModemName),
                "DeviceStatus" => data.OrderByDescending(x => x.Device.DeviceStatus),
                "CreatedOn" => data.OrderByDescending(x => x.Device.CreatedOn),
                _ => data
            };
        }
    }

    private IEnumerable<DeviceViewModel> filteredDevices => string.IsNullOrWhiteSpace(searchTerm)
        ? devicesList
        : devicesList.Where(vm =>
            (vm.Device.DeviceName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Device.DeviceModel?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Device.AddressObject?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Device.ObjectName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Device.ModemName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    protected override async Task OnInitializedAsync()
    {
        // 1. Получаем "чистые" данные из API
        var rawDevices = await DevicesService.GetAllDevicesAsync();

        // 2. 🎯 КЛАССИЧЕСКАЯ ГЕНЕРАЦИЯ: используем LINQ Select с индексом для создания номеров строк
        devicesList = rawDevices.Select((d, index) => new DeviceViewModel
        {
            RowNumber = index + 1,
            Device = d
        }).ToList();

        isLoading = false;
    }

    private void ClearSearch() { searchTerm = ""; }

    private MarkupString HighlightText(string? text)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrWhiteSpace(searchTerm))
        {
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text ?? "—"));
        }

        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var encodedSearch = System.Net.WebUtility.HtmlEncode(searchTerm);

        var highlighted = System.Text.RegularExpressions.Regex.Replace(
                    encoded,
                    System.Text.RegularExpressions.Regex.Escape(encodedSearch),
                    $"<mark>{encodedSearch}</mark>",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase
                );

        return new MarkupString(highlighted);
    }
}