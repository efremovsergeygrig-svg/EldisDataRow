@page "/objects"
@using EldisDataLoader.Models
@inject EldisDataLoader.Web.Services.ObjectsService ObjectsService

<PageTitle>Объекты - Eldis</PageTitle>

<style>
    /* Контейнер с фиксированной высотой и скроллом */
    .table-scroll-container {
        height: calc(100vh - 280px);
        overflow-y: auto;
        overflow-x: auto;
    }

    /* Делаем заголовок "липким" */
    .sticky-thead th {
        position: sticky;
        top: 0;
        background-color: #212529 !important;
        color: white !important;
        z-index: 10;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        white-space: nowrap;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-building text-primary"></i> Объекты
    </h2>
    <span class="badge bg-primary fs-6">
        Всего: @objectsList.Count
    </span>
</div>

@if (isLoading)
{
    <div class="card shadow-sm p-5 text-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <div class="mt-3 text-muted fw-semibold">Загрузка справочника объектов...</div>
    </div>
}
else
{
    <!-- Поле поиска -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text"
                       class="form-control"
                       placeholder="Поиск по названию, адресу или описанию..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i> Очистить
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Информация о результатах поиска -->
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-light border mb-3 py-2">
            <i class="bi bi-funnel"></i>
            Найдено: <strong>@filteredObjects.Count()</strong> из <strong>@objectsList.Count</strong>
            по запросу "<em>@searchTerm</em>"
        </div>
    }

    <!-- Таблица с результатами -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!SortedObjects.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-emoji-frown fs-1"></i>
                    <p class="mt-2 mb-0">По вашему запросу ничего не найдено</p>
                </div>
            }
            else
            {
                <div class="table-responsive table-scroll-container">
                    <table class="table table-hover table-striped table-sm mb-0 compact-table">
                        <thead class="table-dark sticky-thead">
                            <tr>
                                <th @onclick="@(() => SortBy("RowNumber"))" style="cursor: pointer; width: 60px; text-align: center;">🔢 № @GetSortIcon("RowNumber")</th>
                                <th @onclick="@(() => SortBy("Name"))" style="cursor: pointer; width: 30%;">📛 Название @GetSortIcon("Name")</th>
                                <th @onclick="@(() => SortBy("Address"))" style="cursor: pointer; width: 40%;">📍 Адрес @GetSortIcon("Address")</th>
                                <th @onclick="@(() => SortBy("Description"))" style="cursor: pointer; width: 20%;">📝 Описание @GetSortIcon("Description")</th>
                                <th @onclick="@(() => SortBy("CreatedOn"))" style="cursor: pointer; width: 10%;"> Дата создания @GetSortIcon("CreatedOn")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isSorting)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <div class="d-flex flex-column align-items-center">
                                            <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                                            <div class="mt-2 text-muted small">Сортировка данных...</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vm in SortedObjects)
                                {
                                    <tr>
                                        <td class="text-center text-muted fw-bold">@vm.RowNumber</td>
                                        <td class="fw-semibold">@HighlightText(vm.Object.Name)</td>
                                        <td>@HighlightText(vm.Object.Address ?? "—")</td>
                                        <td>@HighlightText(vm.Object.Description ?? "—")</td>
                                        <td>
                                            <small class="text-muted" style="white-space: nowrap;">
                                                @vm.Object.CreatedOn?.ToString("dd.MM.yyyy")
                                            </small>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    // 🎯 КЛАССИЧЕСКИЙ ПАТТЕРН: ViewModel для добавления UI-поля без изменения исходного DTO
    private class ObjectViewModel
    {
        public int RowNumber { get; set; }
        public ObjectDto Object { get; set; }
    }

    private List<ObjectViewModel> objectsList = new();
    private bool isLoading = true;
    private bool isSorting = false;
    private string searchTerm = "";

    private string sortColumn = "RowNumber";
    private bool sortAscending = true;

    private IEnumerable<ObjectViewModel> SortedObjects => ApplySorting(filteredObjects);

    private async Task SortByAsync(string columnName)
    {
        if (sortColumn == columnName)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = columnName;
            sortAscending = true;
        }

        isSorting = true;
        StateHasChanged();
        await Task.Delay(50);
        await Task.Run(() => { _ = SortedObjects.ToList(); });
        isSorting = false;
        StateHasChanged();
    }

    private void SortBy(string columnName) { _ = SortByAsync(columnName); }

    private string GetSortIcon(string columnName)
    {
        if (sortColumn != columnName) return "";
        return sortAscending ? " ▲" : " ▼";
    }

    private IEnumerable<ObjectViewModel> ApplySorting(IEnumerable<ObjectViewModel> data)
    {
        if (string.IsNullOrEmpty(sortColumn)) return data;

        if (sortAscending)
        {
            return sortColumn switch
            {
                "RowNumber" => data.OrderBy(x => x.RowNumber),
                "Name" => data.OrderBy(x => x.Object.Name),
                "Address" => data.OrderBy(x => x.Object.Address),
                "Description" => data.OrderBy(x => x.Object.Description),
                "CreatedOn" => data.OrderBy(x => x.Object.CreatedOn),
                _ => data
            };
        }
        else
        {
            return sortColumn switch
            {
                "RowNumber" => data.OrderByDescending(x => x.RowNumber),
                "Name" => data.OrderByDescending(x => x.Object.Name),
                "Address" => data.OrderByDescending(x => x.Object.Address),
                "Description" => data.OrderByDescending(x => x.Object.Description),
                "CreatedOn" => data.OrderByDescending(x => x.Object.CreatedOn),
                _ => data
            };
        }
    }

    private IEnumerable<ObjectViewModel> filteredObjects => string.IsNullOrWhiteSpace(searchTerm)
        ? objectsList
        : objectsList.Where(vm =>
            (vm.Object.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Object.Address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (vm.Object.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    protected override async Task OnInitializedAsync()
    {
        // 1. Получаем "чистые" данные из API
        var rawObjects = await ObjectsService.GetAllObjectsAsync();

        // 2. 🎯 КЛАССИЧЕСКАЯ ГЕНЕРАЦИЯ: используем LINQ Select с индексом для создания номеров строк
        objectsList = rawObjects.Select((o, index) => new ObjectViewModel
        {
            RowNumber = index + 1,
            Object = o
        }).ToList();

        isLoading = false;
    }

    private void ClearSearch() { searchTerm = ""; }

    private MarkupString HighlightText(string? text)
    {
        if (string.IsNullOrEmpty(text) || string.IsNullOrWhiteSpace(searchTerm))
        {
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text ?? "—"));
        }

        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var encodedSearch = System.Net.WebUtility.HtmlEncode(searchTerm);

        var highlighted = System.Text.RegularExpressions.Regex.Replace(
                    encoded,
                    System.Text.RegularExpressions.Regex.Escape(encodedSearch),
                    $"<mark>{encodedSearch}</mark>",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase
                );

        return new MarkupString(highlighted);
    }
}